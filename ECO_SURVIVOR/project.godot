[layer_names]

2d_physics/layer_1="monde"
2d_physics/layer_2="joueur"
2d_physics/layer_3="objets"
2d_physics/layer_4="dangers"
2d_physics/layer_5="stations"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.08, 0.1, 1)
